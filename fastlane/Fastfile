default_platform(:ios)

SCHEME = "RagaMentor-iOS"

platform :ios do
  desc "Run unit tests on the iOS simulator"
  lane :test do
    run_tests(
      scheme: SCHEME,
      devices: ["iPhone 16"],
      result_bundle: true,
      output_directory: "fastlane/test_output",
      output_types: "junit",
      fail_build: true
    )
  end

  desc "Build an unsigned device IPA (sideload it with SideStore or AltStore)"
  lane :build_unsigned do
    build_app(
      scheme: SCHEME,
      configuration: "Release",
      destination: "generic/platform=iOS",
      skip_codesigning: true,
      skip_package_ipa: true,
      skip_archive: false,
      clean: true,
      archive_path: "build/RagaMentor-iOS.xcarchive",
      output_directory: "build"
    )
    root = sh("git", "rev-parse", "--show-toplevel").strip
    apps = Dir[File.join(root, "build", "*.xcarchive", "Products", "Applications", "*.app")]
    UI.user_error!("No .app found inside the archive under #{root}/build") if apps.empty?
    ipa = File.join(root, "RagaMentor-iOS-unsigned.ipa")
    payload = File.join(root, "Payload")
    sh("rm", "-rf", payload, ipa)
    sh("mkdir", "-p", payload)
    sh("cp", "-r", apps.first, payload)
    sh("cd #{root} && zip -qry #{ipa} Payload")
    sh("rm", "-rf", payload)
    UI.user_error!("IPA was not created at #{ipa}") unless File.exist?(ipa)
    UI.success("Unsigned IPA ready: #{ipa} (#{File.size(ipa)} bytes)")
  end
end
